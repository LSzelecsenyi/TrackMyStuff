<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 8–11 full-backup rules. Only account user-data databases and the
  appearance/settings plus language files are included.
  Android 8 (API 26–27) ignores requireFlags, so encrypted cloud backup cannot
  be required there.
  Android 9–11 honor requireFlags="clientSideEncryption". If the transport
  cannot encrypt, these includes are skipped and this app stores nothing.
  The platform already excludes noBackupFilesDir. That directory is not a domain.
-->
<full-backup-content>
    <include
        domain="file"
        path="strict_user_data"
        requireFlags="clientSideEncryption" />
    <include
        domain="file"
        path="datastore/weight_tracker_settings.preferences_pb"
        requireFlags="clientSideEncryption" />
    <include
        domain="file"
        path="datastore/app_language.preferences_pb"
        requireFlags="clientSideEncryption" />
</full-backup-content>
