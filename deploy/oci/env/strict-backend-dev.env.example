# Copy to /etc/strict/strict-backend-dev.env and chmod 600.
# systemd reads this file. Do not commit the filled-in copy.
SPRING_PROFILES_ACTIVE=dev
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5434/strict_dev
SPRING_DATASOURCE_USERNAME=strict_app
SPRING_DATASOURCE_PASSWORD=replace-with-the-strict-postgres-password
STRICT_GOOGLE_CLIENT_ID=replace-with-the-dev-web-client-id.apps.googleusercontent.com
STRICT_ADMIN_GOOGLE_SUBJECTS=replace-with-comma-separated-google-subject-ids
STRICT_CORS_ALLOWED_ORIGINS=https://admin-dev.strictworkout.eu
STRICT_PLAY_PACKAGE_NAME=com.strictworkout.app.dev
STRICT_BILLING_PRODUCT_IDS=
STRICT_PLAY_SERVICE_ACCOUNT_FILE=
STRICT_PLAY_RTDN_AUDIENCE=
STRICT_PLAY_RTDN_SERVICE_ACCOUNT=
STRICT_FOUNDER_RULES=production
JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m
