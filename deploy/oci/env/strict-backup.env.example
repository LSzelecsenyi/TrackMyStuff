# Server copy: /etc/strict/strict-backup.env
# Owner root, mode 600. Do not commit that file. This example has no secrets.
#
# The script reads these names. They are the region, namespace, bucket, and
# object prefix for the private bucket strict-prod-backups.
# required uploads after the local dump is verified.
# disabled keeps the local dump and does not call OCI.
STRICT_BACKUP_OFFHOST=required
STRICT_BACKUP_REGION=eu-frankfurt-1
STRICT_BACKUP_NAMESPACE=frdlgn4i5lzy
STRICT_BACKUP_BUCKET=strict-prod-backups
STRICT_BACKUP_PREFIX=automatic/
