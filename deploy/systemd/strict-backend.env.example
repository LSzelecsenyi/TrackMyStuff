# Example only. Install the real file as /etc/strict/strict-backend.env
# on the host, mode 0640, owner root, group strict.
# Never commit a filled copy. This example contains no secrets.
#
# systemd reads this file before the process starts. Lines use KEY=value.
# Do not use shell export, quotes, or command substitution.
#
# The service command line forces all of the following, and an entry here
# must not try to override them:
#   spring profile prod
#   server address 127.0.0.1
#   server port 8082
#   maximum heap 512m
#
# Do not set STRICT_FOUNDER_RULES. The prod profile rejects every value
# except production, and production is already the packaged default.
# Do not set STRICT_ADMIN_COOKIE_SECURE. The prod profile forces Secure.

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/strict
SPRING_DATASOURCE_USERNAME=strict_app
SPRING_DATASOURCE_PASSWORD=

STRICT_GOOGLE_CLIENT_ID=
STRICT_ADMIN_GOOGLE_SUBJECTS=

# Optional. Packaged defaults are 30d and 12h.
# STRICT_AUTH_SESSION_LIFETIME=30d
# STRICT_ADMIN_SESSION_LIFETIME=12h
