# Copy this file to keystore.properties in the repository root.
# keystore.properties is gitignored. Do not put real passwords in this example.
# Keep the keystore itself outside the repository.
# In a properties file, write Windows paths with forward slashes, or escape each backslash.
storeFile=C:/Users/you/strict-keys/strict-upload.jks
storePassword=
keyAlias=strict-upload
keyPassword=
